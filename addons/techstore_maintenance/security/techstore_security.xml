<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="module_techstore_maintenance_category" model="ir.module.category">
        <field name="name">TechStore Mantenimiento</field>
        <field name="description">Gestión de mantenimientos técnicos, técnicos y equipos para TechStore.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_techstore_technician" model="res.groups">
        <field name="name">Técnico</field>
        <field name="category_id" ref="module_techstore_maintenance_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_techstore_supervisor" model="res.groups">
        <field name="name">Supervisor Técnico</field>
        <field name="category_id" ref="module_techstore_maintenance_category"/>
        <field name="implied_ids" eval="[(4, ref('group_techstore_technician'))]"/>
    </record>

    <record id="group_techstore_admin" model="res.groups">
        <field name="name">Administrador Técnico</field>
        <field name="category_id" ref="module_techstore_maintenance_category"/>
        <field name="implied_ids" eval="[(4, ref('group_techstore_supervisor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Regla de registro: Técnicos solo ven sus mantenimientos asignados -->
    <record id="rule_techstore_maintenance_technician" model="ir.rule">
        <field name="name">Técnicos: Ver solo mantenimientos asignados</field>
        <field name="model_id" ref="model_techstore_maintenance"/>
        <field name="domain_force">[('technician_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_techstore_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Regla de registro: Admin/Supervisor ven todo -->
    <record id="rule_techstore_maintenance_all" model="ir.rule">
        <field name="name">Admin/Supervisor: Ver todos los mantenimientos</field>
        <field name="model_id" ref="model_techstore_maintenance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_techstore_supervisor')), (4, ref('group_techstore_admin'))]"/>
    </record>
</odoo>
