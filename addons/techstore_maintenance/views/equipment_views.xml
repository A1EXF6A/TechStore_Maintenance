<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="view_techstore_equipment_tree" model="ir.ui.view">
        <field name="name">techstore.equipment.tree</field>
        <field name="model">techstore.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipos">
                <field name="code"/>
                <field name="client_id"/>
                <field name="equipment_type_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="receipt_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'received'"
                       decoration-warning="state == 'under_repair'"
                       decoration-success="state == 'repaired'"
                       decoration-muted="state == 'delivered'"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_techstore_equipment_form" model="ir.ui.view">
        <field name="name">techstore.equipment.form</field>
        <field name="model">techstore.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,under_repair,repaired,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="equipment_type_id"/>
                            <field name="brand"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="receipt_date"/>
                            <field name="has_warranty"/>
                            <field name="state_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción del Problema" name="problem">
                            <field name="problem_description" placeholder="Descripción del problema..."/>
                        </page>
                        <page string="Observaciones" name="observations">
                            <field name="observations" placeholder="Notas adicionales..."/>
                        </page>
                        <page string="Historial de Mantenimientos" name="maintenance_history">
                            <field name="maintenance_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="state"/>
                                    <field name="technician_id"/>
                                    <field name="request_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_techstore_equipment_search" model="ir.ui.view">
        <field name="name">techstore.equipment.search</field>
        <field name="model">techstore.equipment</field>
        <field name="arch" type="xml">
            <search string="Buscar Equipos">
                <field name="code"/>
                <field name="client_id"/>
                <field name="serial_number"/>
                <field name="brand"/>
                <field name="model"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'client_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'equipment_type_id'}"/>
                    <filter string="Estado" name="group_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_techstore_equipment" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">techstore.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra un nuevo equipo!
            </p>
        </field>
    </record>
</odoo>
