<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Asistente de Reportes -->
    <record id="view_techstore_maintenance_report_wizard_form" model="ir.ui.view">
        <field name="name">techstore.maintenance.report.wizard.form</field>
        <field name="model">techstore.maintenance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reportes de Mantenimientos">
                <sheet>
                    <div class="text-center mb-3">
                        <h3>Asistente de Reportes Operativos</h3>
                        <p class="text-muted font-italic">Seleccione el tipo de reporte. Los técnicos solo tienen acceso a reportes detallados de sus propias tareas asignadas.</p>
                    </div>
                    <field name="is_technician_user" invisible="1"/>
                    
                    <group>
                        <field name="report_type" widget="radio" options="{'horizontal': true}" readonly="is_technician_user"/>
                    </group>

                    <group>
                        <group string="Filtro de Fechas">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Filtros Adicionales">
                            <field name="technician_id" 
                                   readonly="is_technician_user" 
                                   invisible="report_type == 'general'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="state" invisible="report_type == 'general'"/>
                        </group>
                    </group>
                    <group invisible="not excel_file">
                        <field name="excel_filename" invisible="1"/>
                        <field name="excel_file" filename="excel_filename" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf" string="Generar PDF" type="object" class="btn-primary oe_highlight"/>
                    <button name="action_generate_excel" string="Generar Excel" type="object" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el asistente -->
    <record id="action_techstore_maintenance_report_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">techstore.maintenance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
