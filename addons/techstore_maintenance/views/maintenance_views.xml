<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Asistente de Cambio de Estado -->
    <record id="view_techstore_maintenance_state_wizard_form" model="ir.ui.view">
        <field name="name">techstore.maintenance.state.wizard.form</field>
        <field name="model">techstore.maintenance.state.wizard</field>
        <field name="arch" type="xml">
            <form string="Historial de Estados">
                <sheet>
                    <group>
                        <field name="maintenance_id"/>
                        <field name="old_state"/>
                        <field name="new_state"/>
                        <field name="change_date"/>
                        <field name="user_id"/>
                        <field name="comment"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="view_techstore_maintenance_tree" model="ir.ui.view">
        <field name="name">techstore.maintenance.tree</field>
        <field name="model">techstore.maintenance</field>
        <field name="arch" type="xml">
            <list string="Mantenimientos"
                  decoration-danger="priority == '3'"
                  decoration-warning="priority == '2'">
                <field name="number"/>
                <field name="client_id"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <field name="request_date"/>
                <field name="maintenance_type"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'nuevo'"
                       decoration-warning="state in ('asignado', 'en_proceso')"
                       decoration-success="state == 'finalizado'"
                       decoration-muted="state == 'cancelado'"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_techstore_maintenance_kanban" model="ir.ui.view">
        <field name="name">techstore.maintenance.kanban</field>
        <field name="model">techstore.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="number"/>
                <field name="client_id"/>
                <field name="equipment_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="maintenance_type"/>
                <field name="technician_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record d-flex flex-column justify-content-between p-3 mb-2 rounded shadow-sm border-top border-4"
                             t-attf-style="border-top: 4px solid #{record.priority.raw_value == '3' ? '#dc3545' : (record.priority.raw_value == '2' ? '#fd7e14' : (record.priority.raw_value == '1' ? '#0d6efd' : '#6c757d'))} !important; background-color: #ffffff; min-height: 120px; transition: transform 0.2s, box-shadow 0.2s;">
                            <div class="oe_kanban_details w-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <strong class="o_kanban_record_title text-primary text-uppercase" style="font-size: 1.05rem; font-weight: 700;">
                                        <field name="number"/>
                                    </strong>
                                    <span t-if="record.maintenance_type.raw_value == 'preventive'" class="badge rounded-pill bg-info text-white px-2 py-1" style="font-size: 0.75rem;">
                                        Preventivo
                                    </span>
                                    <span t-elif="record.maintenance_type.raw_value == 'corrective'" class="badge rounded-pill bg-danger text-white px-2 py-1" style="font-size: 0.75rem;">
                                        Correctivo
                                    </span>
                                    <span t-elif="record.maintenance_type.raw_value == 'diagnostic'" class="badge rounded-pill bg-warning text-dark px-2 py-1" style="font-size: 0.75rem;">
                                        Diagnóstico
                                    </span>
                                </div>
                                <div class="text-truncate mb-1 text-secondary" style="font-size: 0.9rem;">
                                    <i class="fa fa-user me-1 text-muted" style="width: 14px;"/>
                                    <strong>Cliente: </strong>
                                    <field name="client_id"/>
                                </div>
                                <div class="text-truncate mb-2 text-secondary" style="font-size: 0.9rem;">
                                    <i class="fa fa-laptop me-1 text-muted" style="width: 14px;"/>
                                    <strong>Equipo: </strong>
                                    <field name="equipment_id"/>
                                </div>
                                <div class="o_kanban_record_bottom d-flex align-items-center justify-content-between pt-2 border-top" style="border-top: 1px solid #f2f2f2 !important;">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right d-flex align-items-center">
                                        <span t-if="record.technician_id.raw_value" class="text-secondary small d-flex align-items-center">
                                            <i class="fa fa-wrench me-1 text-muted"/>
                                            <field name="technician_id"/>
                                        </span>
                                        <span t-else="" class="badge bg-light text-danger small px-2 py-1 border border-danger-subtle">
                                            Sin Técnico
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_techstore_maintenance_form" model="ir.ui.view">
        <field name="name">techstore.maintenance.form</field>
        <field name="model">techstore.maintenance</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Mantenimiento">
                <header>
                    <button name="action_to_asignado"
                            type="object"
                            string="Asignar"
                            invisible="state != 'nuevo'"
                            class="oe_highlight"
                            groups="techstore_maintenance.group_techstore_supervisor,techstore_maintenance.group_techstore_admin"/>
                    <button name="action_to_en_proceso"
                            type="object"
                            string="Iniciar Proceso"
                            invisible="state not in ('nuevo', 'asignado', 'pendiente')"
                            class="oe_highlight"/>
                    <button name="action_to_pendiente"
                            type="object"
                            string="Poner en Pendiente"
                            invisible="state != 'en_proceso'"
                            class="btn-secondary"/>
                    <button name="action_to_finalizado"
                            type="object"
                            string="Finalizar"
                            invisible="state not in ('en_proceso', 'pendiente')"
                            class="oe_highlight"/>
                    <button name="action_to_cancelado"
                            type="object"
                            string="Cancelar"
                            invisible="state in ('finalizado', 'cancelado')"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="nuevo,asignado,en_proceso,pendiente,finalizado,cancelado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number"/>
                        </h1>
                    </div>
                    <field name="is_technician_readonly" invisible="1"/>
                    <group>
                        <group string="Cliente y Equipo">
                            <field name="client_id"/>
                            <field name="equipment_id" domain="[('client_id', '=', client_id), ('state', '=', 'received')]"/>
                            <field name="technician_id" options="{'no_create': True}" readonly="is_technician_readonly"/>
                        </group>
                        <group string="Planificación">
                            <field name="maintenance_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="request_date" readonly="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problema y Diagnóstico" name="problem">
                            <group>
                                <field name="description"/>
                                <field name="diagnosis"/>
                                <field name="solution"/>
                            </group>
                        </page>
                        <page string="Costos y Tiempos" name="costs">
                            <group>
                                <group string="Costos">
                                    <field name="estimated_cost"/>
                                    <field name="final_cost"/>
                                </group>
                                <group string="Tiempo de Ejecución">
                                    <field name="estimated_time"/>
                                    <field name="real_time"/>
                                </group>
                            </group>
                        </page>
                        <page string="Satisfacción e Historial" name="history">
                            <group>
                                <field name="customer_satisfaction" widget="priority"/>
                                <field name="observations"/>
                            </group>
                            <separator string="Historial de Estados"/>
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="change_date"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="user_id"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_techstore_maintenance_search" model="ir.ui.view">
        <field name="name">techstore.maintenance.search</field>
        <field name="model">techstore.maintenance</field>
        <field name="arch" type="xml">
            <search string="Buscar Mantenimientos">
                <field name="number"/>
                <field name="client_id"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <filter string="Mis Mantenimientos" name="my_maintenances" domain="[('technician_id.user_id', '=', uid)]"/>
                <filter string="Prioridad Crítica" name="critical" domain="[('priority', '=', '3')]"/>
                <filter string="Pendientes" name="pending" domain="[('state', 'not in', ('finalizado', 'cancelado'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Técnico" name="group_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Cliente" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Prioridad" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Tipo de Mantenimiento" name="group_type" context="{'group_by': 'maintenance_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_techstore_maintenance" model="ir.actions.act_window">
        <field name="name">Mantenimientos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">techstore.maintenance</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera solicitud de mantenimiento!
            </p>
        </field>
    </record>
</odoo>
