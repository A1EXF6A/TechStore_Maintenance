<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Lista -->
    <record id="view_techstore_technician_tree" model="ir.ui.view">
        <field name="name">techstore.technician.tree</field>
        <field name="model">techstore.technician</field>
        <field name="arch" type="xml">
            <list string="Técnicos">
                <field name="name"/>
                <field name="identification"/>
                <field name="phone"/>
                <field name="specialty"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="maintenance_count"/>
                <field name="workload_level" widget="badge"
                       decoration-success="workload_level == 'low'"
                       decoration-warning="workload_level == 'medium'"
                       decoration-danger="workload_level in ('high', 'critical')"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_techstore_technician_form" model="ir.ui.view">
        <field name="name">techstore.technician.form</field>
        <field name="model">techstore.technician</field>
        <field name="arch" type="xml">
            <form string="Técnico">
                <header>
                    <button name="action_create_or_link_user"
                            type="object"
                            string="Crear / Vincular Usuario Odoo"
                            class="oe_highlight"
                            invisible="user_id != False"
                            groups="techstore_maintenance.group_techstore_admin,techstore_maintenance.group_techstore_supervisor"/>
                    <button name="action_create_or_link_user"
                            type="object"
                            string="Reconfigurar Usuario Odoo"
                            invisible="user_id == False"
                            groups="techstore_maintenance.group_techstore_admin"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre Completo"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos Personales">
                            <field name="identification"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="specialty"/>
                        </group>
                        <group string="Acceso al Sistema">
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                            <field name="active"/>
                            <field name="maintenance_count"/>
                            <field name="workload_level" widget="badge"
                                   decoration-success="workload_level == 'low'"
                                   decoration-warning="workload_level == 'medium'"
                                   decoration-danger="workload_level in ('high', 'critical')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones" name="observations">
                            <field name="observations" placeholder="Notas adicionales..."/>
                        </page>
                        <page string="Mantenimientos Asignados" name="maintenances">
                            <field name="maintenance_ids" readonly="1">
                                <list>
                                    <field name="number"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="priority"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_techstore_technician_search" model="ir.ui.view">
        <field name="name">techstore.technician.search</field>
        <field name="model">techstore.technician</field>
        <field name="arch" type="xml">
            <search string="Buscar Técnicos">
                <field name="name"/>
                <field name="identification"/>
                <field name="specialty"/>
                <field name="user_id"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Con Usuario Vinculado" name="with_user" domain="[('user_id', '!=', False)]"/>
                <filter string="Sin Usuario Vinculado" name="without_user" domain="[('user_id', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Especialidad" name="group_specialty" context="{'group_by': 'specialty'}"/>
                    <filter string="Nivel de Carga" name="group_workload" context="{'group_by': 'workload_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_techstore_technician" model="ir.actions.act_window">
        <field name="name">Técnicos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">techstore.technician</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primer técnico!
            </p>
        </field>
    </record>
</odoo>
